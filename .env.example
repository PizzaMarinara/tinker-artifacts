# Self-hosted tinker-artifacts server configuration.
# Register uploader keys (see README): each runs `tinker-share keygen <name>` and
# sends you their "name:pubkey" line; comma-separate multiple.
UPLOAD_KEYS=alice:REPLACE_WITH_PUBKEY

# Retention menu (optional; defaults shown). <n>m|h|d, 60s–365d each; DEFAULT_TTL must be in TTL_OPTIONS.
TTL_OPTIONS=1h,1d,7d,30d
DEFAULT_TTL=7d

# HTTP port.
PORT=8080

# Storage backend: "sqlite" (default, one file) or "redis".
STORAGE=sqlite
SQLITE_PATH=./tinker.db
# REDIS_URL=redis://localhost:6379
